{
  "name": "comptabilite-pro",
  "version": "1.0.0",
  "description": "Logiciel de comptabilité pour autoentrepreneur — factures, URSSAF, TVA, déclarations.",
  "author": {
    "name": "Comptabilité Pro",
    "email": "contact@comptabilite.pro"
  },
  "homepage": "https://github.com/tanguybdv-boop/skills",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "fr.comptabilite.pro",
    "productName": "Comptabilité Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "web/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Comptabilité Pro"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Comptabilité Pro <contact@comptabilite.pro>",
      "icon": "assets/icon.png"
    }
  }
}
